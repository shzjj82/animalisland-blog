# 宿主机端口（api=Express，web=Next；勿再写笼统 PORT，避免两服务抢同一变量）
API_PORT=3001
WEB_PORT=5173

# SQLite 与本地上传（仅未配 GATEWAY、走本机库时需要）
DATABASE_PATH=./data/blog.db
UPLOAD_DIR=./data/uploads
# 本地注册/登录签名密钥（未配 GATEWAY 时生效；生产请改成随机长串）
# LOCAL_AUTH_SECRET=

# ---------- Nest 网关（配了即用 Nest 内容+登录，不必再写 CONTENT_BACKEND=docs）----------
# Docker：compose 会设 GATEWAY_BASE_URL=http://host.docker.internal:3000
# blog server / editor（pnpm dev:editor）都读仓库根这个变量
# editor 浏览器默认同源请求，由 Vite 把 /auth /docs /agents /upload 代理到此地址（避免 CORS）
# 若要浏览器直连网关，另设 VITE_GATEWAY_PUBLIC_BASE=https://…
GATEWAY_BASE_URL=http://127.0.0.1:3000
# 文档服务密钥（x-docs-key）；别名 DOCS_SERVICE_KEY。仅 /docs，智能体聊天勿用。生产勿用弱默认，≥16 位
GATEWAY_SERVICE_KEY=dev-docs-key
# 高级覆盖（一般不用）：AUTH_APP_CODE=web（请求头 X-App-Code）、DOCS_APP_CODE=blog（X-Biz-Code 与文档 X-App-Code）、AGENTS_BIZ_CODE=blog、GATEWAY_TIMEOUT_MS=15000、AGENTS_TIMEOUT_MS=90000
# editor（Web/桌面）固定请求头 X-Biz-Code / X-App-Code = wiki，与博客 blog 隔离；勿与 DOCS_APP_CODE 混用
# 仅本机 SQLite（含本地注册登录）：删掉 GATEWAY_BASE_URL，并设 CONTENT_BACKEND=local

# 对外站点（sitemap / OG）。填 https://… 时登录 cookie 带 Secure
SITE_URL=

# 配了网关时，登录/注册走 Nest usercenter（种子：admin / admin123）
# 未配网关时，登录走本机 SQLite；启动会确保 admin / admin123，并把无作者的文章归给他
# AI 写作：走 Nest POST /agents/chat（用户 JWT + X-Biz-Code），不要配 AI_API_*；需在业务后台开通

# 以下本机有默认值，一般不用写进 .env：
# - Express 监听 HOST=0.0.0.0，端口=API_PORT
# - Next 端口=WEB_PORT；SSR/代理默认 http://127.0.0.1:$API_PORT
# - Docker 下 INTERNAL_API_URL 由 compose/Dockerfile 固定为 http://api:3001
# - CORS：经 Next 同源代理时可空；开发直连 API 时默认 http://localhost:$WEB_PORT

# 阿里云 OSS（可选；密钥勿提交）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_REGION=oss-cn-shanghai
OSS_BUCKET=championsea
OSS_PREFIX=blog
OSS_PUBLIC_BASE=
