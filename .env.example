# 服务
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# SQLite 与本地上传目录（相对仓库根目录）
DATABASE_PATH=./data/blog.db
UPLOAD_DIR=./data/uploads

# 开发时 Vite 源，生产可留空（同源 cookie）
CORS_ORIGIN=http://localhost:5173

# 登录（个人站单用户）
JWT_SECRET=please-change-this-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
JWT_EXPIRES_DAYS=7

# 阿里云 OSS（图片上传；密钥只放本机 .env，不要提交）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_REGION=oss-cn-shanghai
OSS_BUCKET=championsea
OSS_PREFIX=blog
OSS_PUBLIC_BASE=
