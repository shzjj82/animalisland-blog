# 服务
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# SQLite 与本地上传目录（相对仓库根目录；Docker 内见下方）
DATABASE_PATH=./data/blog.db
UPLOAD_DIR=./data/uploads

# 开发时 Vite 源，生产可留空（同源 cookie）
CORS_ORIGIN=http://localhost:5173

# 文档服务（Nest 网关）。Next.js / Express 只把文章/分类/关于页打到这里
# 登录、上传、AI 仍走本服务，不要把 DOCS_SERVICE_KEY 暴露给浏览器
DOCS_BASE_URL=http://127.0.0.1:3000
DOCS_SERVICE_KEY=dev-docs-key

# 对外站点地址，用来生成 sitemap / canonical / Open Graph（生产务必填）
SITE_URL=

# 登录（个人站单用户）
# 生产环境禁止使用下方弱默认值；JWT_SECRET 建议 ≥24 位随机串
JWT_SECRET=please-change-this-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
JWT_EXPIRES_DAYS=7

# 阿里云 OSS（可选；未配置或上传失败时回退到本地 /uploads）
# 密钥只放本机 .env，不要提交
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_REGION=oss-cn-shanghai
OSS_BUCKET=championsea
OSS_PREFIX=blog
OSS_PUBLIC_BASE=

# AI 写作助手（OpenAI 兼容 Chat Completions；密钥只放本机 .env）
# 例：OpenAI https://api.openai.com/v1
# 例：DeepSeek https://api.deepseek.com/v1
# 例：通义兼容 https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=90000

# ---------- Docker（pnpm docker:up / docker compose up -d --build）----------
# compose 会覆盖：NODE_ENV=production、DATABASE_PATH=/app/data/blog.db、UPLOAD_DIR=/app/data/uploads
# 数据卷 myblog-data → /app/data；入口脚本会 chown 给 uid 1001
# 务必改 JWT_SECRET / ADMIN_PASSWORD，并填 SITE_URL
