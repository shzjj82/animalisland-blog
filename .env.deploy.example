# 部署专用变量（给 scripts/docker-*.sh 用）
# 与项目根目录 .env（应用运行时）无关，请勿混用
# 用法：cp .env.deploy.example .env.deploy 后按需填写
# 也可直接 export，或用脚本 CLI 参数覆盖

# 镜像与产物
DEPLOY_IMAGE=myblog:latest
DEPLOY_PLATFORM=linux/amd64
DEPLOY_ARCHIVE=myblog-amd64.tar.gz

# 本机打包输出目录（相对仓库根或绝对路径）
DEPLOY_OUT_DIR=.

# SSH 上传（docker-pack-upload.sh）
DEPLOY_SSH_HOST=
DEPLOY_SSH_USER=root
DEPLOY_SSH_PORT=22
# 可选：私钥路径；留空则用 ssh 默认配置
DEPLOY_SSH_KEY=
# 服务器上存放压缩包 / compose 的目录
DEPLOY_REMOTE_DIR=/opt/myblog

# 服务器加载（docker-load.sh）
# 加载后是否执行 docker compose up -d --no-build（1/0）
DEPLOY_COMPOSE_UP=1
