{
  "manifest_version": 3,
  "name": "wiki-agent 工作助手",
  "version": "0.0.27",
  "description": "把当前标签页交给 wiki-agent 工作台操作。",
  "action": {
    "default_title": "wiki-agent 工作",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "tabs", "scripting", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
