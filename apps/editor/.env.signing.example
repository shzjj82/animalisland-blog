# 桌面安装包签名与公证（给 scripts/pack-desktop.mjs 用）
# 用法：cp .env.signing.example .env.signing 后填写；.env.signing 不进 git
# 不填时照样出包，但只能自己用，发给别人会被 Gatekeeper 拦下

# macOS 签名证书：钥匙串里「Developer ID Application」证书的完整名称
# 查看：security find-identity -v -p codesigning
# 注意「Apple Development」证书不能用于对外分发
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# macOS 公证，二选一
# 方式一（推荐）：App Store Connect API 密钥（用户和访问 → 集成 → 团队密钥）
APPLE_API_ISSUER=
APPLE_API_KEY=
APPLE_API_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8

# 方式二：Apple ID + App 专用密码（appleid.apple.com → 登录与安全 → App 专用密码）
# APPLE_ID=you@example.com
# APPLE_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=TEAMID
