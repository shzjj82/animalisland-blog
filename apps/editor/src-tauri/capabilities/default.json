{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "编辑器主窗口",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    "allow-pick-save-path",
    "allow-write-export-file",
    "allow-export-pdf",
    "allow-set-native-menu-locale",
    "allow-enforce-required-update",
    "allow-run-ai-command",
    "allow-open-ai-target",
    "allow-read-ai-file",
    "allow-list-installed-browsers",
    "allow-open-installed-browser",
    "allow-reveal-work-extension"
  ],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  }
}
