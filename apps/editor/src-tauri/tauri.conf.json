{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wiki-agent",
  "version": "0.0.8",
  "identifier": "online.championsea.wiki-agent",
  "build": {
    "beforeDevCommand": "pnpm --filter @myblog/shared build && pnpm dev",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "pnpm build:desktop",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFODY4QTYwNDc4NEFENEYK\nUldSUHJZUkhZSXFHanAyMy9aNzdnRVR4dEZYSUFpTzlabjRxbStwTUdBbU9QbmFGU1UwYmJtUTEK",
      "endpoints": [
        "https://championsea.oss-cn-shanghai.aliyuncs.com/wiki-agent/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "wiki-agent",
        "width": 1280,
        "height": 840,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "visible": false,
        "dragDropEnabled": false,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
