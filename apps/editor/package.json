{
  "name": "@myblog/editor",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:desktop": "pnpm --filter @myblog/shared build && pnpm build && node scripts/bundle-server.mjs",
    "desktop": "tauri dev",
    "pack:web": "pnpm --filter @myblog/shared build && pnpm build && node scripts/bundle-server.mjs && node scripts/pack-web.mjs",
    "pack:macos": "node scripts/pack-desktop.mjs macos",
    "pack:windows": "node scripts/pack-desktop.mjs windows",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@editorjs/delimiter": "^1.4.2",
    "@editorjs/editorjs": "^2.30.8",
    "@editorjs/header": "^2.8.8",
    "@editorjs/list": "^2.0.8",
    "@editorjs/quote": "^2.7.6",
    "@editorjs/table": "^2.4.5",
    "@icon-park/react": "^1.4.2",
    "@myblog/shared": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "docx": "9.5.0",
    "docx-preview": "^0.4.1",
    "editorjs-drag-drop": "^1.1.16",
    "highlight.js": "^11.12.0",
    "i18next": "^26.4.2",
    "mammoth": "^1.8.0",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.15",
    "shadcn": "^4.21.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@tauri-apps/cli": "^2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.8",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
